# ============================================================
# Digital Marketplace — Root Environment Example
# Copy to .env and fill in real values. NEVER commit .env files.
# ============================================================

# Application
NODE_ENV=development
APP_NAME="Digital Marketplace"
APP_URL=http://localhost:3000

# ------------------------------------------------------------
# Backend (Render deployment uses these too)
# ------------------------------------------------------------
API_PORT=5000
API_URL=http://localhost:5000

# PostgreSQL connection string
# Local Docker: postgresql://postgres:postgres@localhost:5432/digital_marketplace
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/digital_marketplace

# Auth / Sessions
AUTH_SECRET=change-me-to-a-long-random-string-at-least-64-chars
JWT_EXPIRES_IN=7d
SESSION_COOKIE_NAME=dm_session

# ------------------------------------------------------------
# Google OAuth (https://console.cloud.google.com/apis/credentials)
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------
# Razorpay (https://dashboard.razorpay.com/app/keys)
# Optional - leave blank to use mock/test checkout
# ------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ------------------------------------------------------------
# File Storage (private object storage)
# Local development uses local disk storage under ./private-storage
# Production: S3 / Cloudflare R2 / DigitalOcean Spaces
# ------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./private-storage
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
SIGNED_URL_TTL_MINUTES=10

# ------------------------------------------------------------
# Email (SMTP or EmailJS for automated gift code delivery)
# ------------------------------------------------------------
EMAIL_DRIVER=console
EMAIL_FROM="Digital Marketplace <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_API_KEY=

# EmailJS Service Keys (from https://dashboard.emailjs.com/)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# ------------------------------------------------------------
# Frontend (Vercel)
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ------------------------------------------------------------
# Gift Codes admin module (Nexora panel → backend API proxy)
# GIFT_API_URL: base URL of the Gift Codes backend
# GIFT_ADMIN_*: backend admin credentials (defaults match seed:
#   SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD)
# ------------------------------------------------------------
GIFT_API_URL=http://localhost:5000
GIFT_ADMIN_EMAIL=admin@example.com
GIFT_ADMIN_PASSWORD=Admin@12345

# ------------------------------------------------------------
# Legacy root Next.js app (Website 1) — NextAuth (Optional)
# ------------------------------------------------------------
# NEXTAUTH_URL="https://your-domain.vercel.app"
# NEXTAUTH_SECRET=""