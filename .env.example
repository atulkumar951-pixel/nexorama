# Database URL (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/digimart"

# Razorpay Payment Gateway (Optional - leave blank to use mock/test checkout)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Google OAuth 2.0 (Optional - for Google Login / Signup)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

